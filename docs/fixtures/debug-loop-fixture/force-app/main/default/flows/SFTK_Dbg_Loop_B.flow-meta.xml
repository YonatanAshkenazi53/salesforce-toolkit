<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Admin Toolkit fixture for the Debugger: the second of two after-save flows: Salesforce never re-runs a flow for the update it made itself, but each of these two updates the record and so fires the OTHER one — together they loop — a recursion loop, stopped by its own entry condition at 5. Exists to be SEEN in a debug log; it does nothing useful.</description>
    <formulas>
        <name>Plus1</name>
        <dataType>Number</dataType>
        <expression>{!$Record.SFTK_Dbg_Count__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>SFTK Dbg Loop B {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SFTK Dbg Loop B</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processMetadataValues><name>OriginBuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Count_Up_B</name>
        <label>Count up on the same record</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>SFTK_Dbg_Count__c</field>
            <value><elementReference>Plus1</elementReference></value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Count_Up_B</targetReference></connector>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SFTK_Dbg_Count__c</field>
            <operator>LessThan</operator>
            <value><numberValue>5.0</numberValue></value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
