<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Admin Toolkit fixture: SCREEN flow that reads a packaged object (DLRS Lookup Child) filtered by SFTK_Pkg_Tag__c and shows the name. Safe to delete.</description>
    <interviewLabel>SFTK Pkg Screen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SFTK Pkg Screen</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processMetadataValues><name>OriginBuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processType>Flow</processType>
    <start><locationX>50</locationX><locationY>0</locationY><connector><targetReference>Find_Child</targetReference></connector></start>
    <recordLookups>
        <name>Find_Child</name><label>Find Child</label><locationX>176</locationX><locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Show</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Name</field><operator>StartsWith</operator><value><stringValue>SFTK Pkg</stringValue></value></filters>
        <filters><field>SFTK_Pkg_Tag__c</field><operator>IsNull</operator><value><booleanValue>false</booleanValue></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>dlrs__LookupChild__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Show</name><label>Show</label><locationX>176</locationX><locationY>278</locationY>
        <allowBack>true</allowBack><allowFinish>true</allowFinish><allowPause>true</allowPause>
        <fields><name>Txt</name><fieldText>&lt;p&gt;Child: {!Find_Child.Name}&lt;/p&gt;</fieldText><fieldType>DisplayText</fieldType></fields>
        <showFooter>true</showFooter><showHeader>true</showHeader>
    </screens>
    <status>Active</status>
</Flow>
