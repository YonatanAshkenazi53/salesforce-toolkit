{
  "manifest_version": 3,
  "name": "Salesforce Toolkit",
  "version": "1.0.0",
  "description": "Salesforce admin toolkit: bulk-manage flows, Lightning pages, permission sets, licenses, field dependencies, and record copy — all from one place.",

  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "popup.html", "popup.js", "styles.css", "debug-logger.js",
        "dependency-map.js", "conflict-scanner.js", "apex-debugger.js",
        "lightning-pages.js", "user-copy.js", "license-manager.js",
        "flow-permissions.js", "field-cleaner.js", "record-copy.js",
        "studio.html", "studio.css", "studio.js",
        "apex-log-viewer.html", "apex-log-viewer.css", "apex-log-viewer.js",
        "trusted-types-policy.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.develop.my.salesforce.com/*",
    "https://*.lightning.force.com/*",
    "https://*.develop.lightning.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://*.my.salesforce-setup.com/*",
    "https://*.develop.my.salesforce-setup.com/*",
    "https://*.force.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://*.salesforce.com https://*.force.com https://*.salesforce-setup.com; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types sftk-html;"
  },

  "action": {
    "default_title": "Salesforce Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
